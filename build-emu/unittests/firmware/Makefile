	cd /Users/highlander/WebstormProjects/keepkey-stack/projects/keepkey-firmware/build-emu && $(MAKE) $(MAKESILENT) -f unittests/firmware/CMakeFiles/firmware-unit.dir/build.make unittests/firmware/CMakeFiles/firmware-unit.dir/zcash.cpp.o
.PHONY : zcash.cpp.o

zcash.i: zcash.cpp.i
.PHONY : zcash.i

# target to preprocess a source file
zcash.cpp.i:
	cd /Users/highlander/WebstormProjects/keepkey-stack/projects/keepkey-firmware/build-emu && $(MAKE) $(MAKESILENT) -f unittests/firmware/CMakeFiles/firmware-unit.dir/build.make unittests/firmware/CMakeFiles/firmware-unit.dir/zcash.cpp.i
.PHONY : zcash.cpp.i

zcash.s: zcash.cpp.s
.PHONY : zcash.s

# target to generate assembly for a file
zcash.cpp.s:
	cd /Users/highlander/WebstormProjects/keepkey-stack/projects/keepkey-firmware/build-emu && $(MAKE) $(MAKESILENT) -f unittests/firmware/CMakeFiles/firmware-unit.dir/build.make unittests/firmware/CMakeFiles/firmware-unit.dir/zcash.cpp.s
.PHONY : zcash.cpp.s

